# ─── JRU Athletics Portal — Environment Configuration ─────────────────────────
# Copy this file to .env and fill in your values.

# ── SQLite (Local Development) ────────────────────────────────────────────────
DATABASE_URL=sqlite:///sports_science.db
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# ── PostgreSQL (Production Server) ────────────────────────────────────────────
# 1. Install PostgreSQL on your server
# 2. Create a database:  CREATE DATABASE jru_athletics;
# 3. Create a user:      CREATE USER jru_user WITH PASSWORD 'your_secure_password';
# 4. Grant access:       GRANT ALL PRIVILEGES ON DATABASE jru_athletics TO jru_user;
# 5. Comment out the SQLite line above and uncomment below:
#
# DATABASE_URL=postgresql://jru_user:your_secure_password@localhost:5432/jru_athletics
# SECRET_KEY=a-long-random-secret-key-at-least-32-characters
# FLASK_ENV=production
#
# Connection pooling (10 connections, auto-reconnect) is enabled automatically
# when a PostgreSQL DATABASE_URL is detected.
